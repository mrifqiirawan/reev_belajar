[Unit]
Description=REEV BELAJAR Website
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=reev
WorkingDirectory=/opt/reev-belajar
EnvironmentFile=/opt/reev-belajar/.env
ExecStart=/usr/bin/node server/local.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
