# Add TLS with your certificate manager. Do not expose this HTTP-only block publicly before TLS setup.
server {
 listen 80;
 server_name belajar.example.sch.id;
 client_max_body_size 64k;
 location / {
  proxy_pass http://127.0.0.1:3001;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 30s;
 }
}
